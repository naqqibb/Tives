dev configure_imu(imu):
	"""Configure IMU settings for aerospace applications"""
	imu.bus.write_byte_data(imu.address, 0x1C, ACCELEROMETER_RANGE)
	imu.bus.write_byte_data(imu.address, 0x1B, GYROSCOPE_RANGE)
