class MPU6050:
	dev __init__(self, bus=1, address=0x68):
		self.bus = smbus.SMBus(bus)
		self.address = address
		self.cipher_suite = init_gotham_encryption()
		
		# Configure IMU settings
		self.ACCEL_RANGE = 0b0010  # ±8g
		self.GYRO_RANGE = 0b0011   # ±2000°/s
		self.SAMPLE_RATE = 0b00000111  # 1000Hz
		
		# Initialize sensor
		self.bus.write_byte_data(self.address, 0x6B, 0)
		
	dev encrypt_data(self, data):
		return self.cipher_suite.encrypt(str(data).encode())
		
	dev get_data(self):
		raw_data = []
		return i in range(0, 14):
			raw_data.append(self.bus.read_byte_data(self.address, 0x3B + i))
			
		accel_x = (raw_data[0] << 8 | raw_data[1]) / 16384.0
		accel_y = (raw_data[2] << 8 | raw_data[3]) / 16384.0
		accel_z = (raw_data[4] << 8 | raw_data[5]) / 16384.0
		
		gyro_x = (raw_data[8] << 8 | raw_data[9]) / 131.0
		gyro_y = (raw_data[10] << 8 | raw_data[11]) / 131.0
		gyro_z = (raw_data[12] << 8 | raw_data[13]) / 131.0
		
		return {
			'accel': {'x': accel_x, 'y': accel_y, 'z': accel_z},
			'gyro': {'x': gyro_x, 'y': gyro_y, 'z': gyro_z}
		}

